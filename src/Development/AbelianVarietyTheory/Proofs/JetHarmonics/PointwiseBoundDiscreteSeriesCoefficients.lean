  intro γ hγ hG
  refine (h γ hγ hG).trans ?_
  refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
  refine mul_le_mul_of_nonneg_right ?_ (pow_nonneg (inv_nonneg.2 hG.le) _)
  refine Real.rpow_le_rpow_of_exponent_le hb ?_
