  first | exact @GlobalTheory.PtTie.evI_eq_thExpr_ext | exact GlobalTheory.PtTie.evI_eq_thExpr_ext | (intros; apply GlobalTheory.PtTie.evI_eq_thExpr_ext <;> assumption)
