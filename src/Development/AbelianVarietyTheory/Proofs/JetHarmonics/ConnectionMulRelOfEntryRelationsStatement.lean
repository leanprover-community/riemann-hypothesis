  first | exact @GlobalTheory.HatNF.MulRelAlg.mulRel_of_entries | exact GlobalTheory.HatNF.MulRelAlg.mulRel_of_entries | (intros; apply GlobalTheory.HatNF.MulRelAlg.mulRel_of_entries <;> assumption)
