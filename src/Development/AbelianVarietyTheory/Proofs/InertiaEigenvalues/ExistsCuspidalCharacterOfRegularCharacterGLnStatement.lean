  first | exact @GlobalTheory.GreenRegular.exists_cusp_of_regular | exact GlobalTheory.GreenRegular.exists_cusp_of_regular | (intros; apply GlobalTheory.GreenRegular.exists_cusp_of_regular <;> assumption)
