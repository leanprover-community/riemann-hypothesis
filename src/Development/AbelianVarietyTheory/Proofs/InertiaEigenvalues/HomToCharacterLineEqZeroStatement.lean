  first | exact @GlobalTheory.Models.ModTh.hom_chr_eq_zero | exact GlobalTheory.Models.ModTh.hom_chr_eq_zero | (intros; apply GlobalTheory.Models.ModTh.hom_chr_eq_zero <;> assumption)
