  first | (exact @GlobalTheory.BKLim.adaptedBasis_theta_and_poles) | (exact GlobalTheory.BKLim.adaptedBasis_theta_and_poles) | (intros; apply GlobalTheory.BKLim.adaptedBasis_theta_and_poles  <;> assumption)
