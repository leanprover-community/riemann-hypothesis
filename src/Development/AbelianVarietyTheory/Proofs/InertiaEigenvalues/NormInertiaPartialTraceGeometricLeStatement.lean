  first | exact @GlobalTheory.PartialTraceGain.norm_sum_pow_le | exact GlobalTheory.PartialTraceGain.norm_sum_pow_le | (intros; apply GlobalTheory.PartialTraceGain.norm_sum_pow_le <;> assumption)
