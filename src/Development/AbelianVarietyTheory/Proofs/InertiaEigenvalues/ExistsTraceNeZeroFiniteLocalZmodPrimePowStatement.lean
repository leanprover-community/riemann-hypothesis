  first | exact @GlobalTheory.LocalTraceNonzero.exists_trace_ne_zero | exact GlobalTheory.LocalTraceNonzero.exists_trace_ne_zero | (intros; apply GlobalTheory.LocalTraceNonzero.exists_trace_ne_zero <;> assumption)
