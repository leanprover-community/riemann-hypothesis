  first | exact @GlobalTheory.UnitaryBC.exists_locUnitary_embedding | exact GlobalTheory.UnitaryBC.exists_locUnitary_embedding | (intros; apply GlobalTheory.UnitaryBC.exists_locUnitary_embedding <;> assumption)
