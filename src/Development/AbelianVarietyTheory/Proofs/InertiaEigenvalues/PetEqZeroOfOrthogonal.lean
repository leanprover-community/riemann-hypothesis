  obtain ⟨p, hp0, hp⟩ := GlobalTheory.CommutingPoly.exists_poly_annihilates_linear_combination A hc c P hP
  refine ⟨p, hp0, fun φ hK hN => ?_⟩
  have e : ∑ i, c i • A i = lapOp E a := by
