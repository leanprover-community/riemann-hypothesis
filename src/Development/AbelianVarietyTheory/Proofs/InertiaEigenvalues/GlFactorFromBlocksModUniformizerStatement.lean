  first | exact @GlobalTheory.gl_factor_fromBlocks_mod_uniformizer | exact GlobalTheory.gl_factor_fromBlocks_mod_uniformizer | (intros; apply GlobalTheory.gl_factor_fromBlocks_mod_uniformizer <;> assumption)
