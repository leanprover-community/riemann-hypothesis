  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih => rw [Finset.prod_insert ha, Finset.sum_insert ha, ih, zpow_add₀ hq]

theorem sum_pairs_eq_wtS {n : ℕ} (a : Fin n → ℤ) :
