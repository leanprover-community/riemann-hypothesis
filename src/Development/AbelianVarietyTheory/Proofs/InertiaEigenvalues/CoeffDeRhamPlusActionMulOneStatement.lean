  first | exact @GlobalTheory.BKGal.JumpDR.odAct_mul_one | exact GlobalTheory.BKGal.JumpDR.odAct_mul_one | (intros; apply GlobalTheory.BKGal.JumpDR.odAct_mul_one <;> assumption)
