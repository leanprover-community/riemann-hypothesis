  first | exact @GlobalTheory.UnitLemma.DescentGL.countGL_prod | exact GlobalTheory.UnitLemma.DescentGL.countGL_prod | (intros; apply GlobalTheory.UnitLemma.DescentGL.countGL_prod <;> assumption)
