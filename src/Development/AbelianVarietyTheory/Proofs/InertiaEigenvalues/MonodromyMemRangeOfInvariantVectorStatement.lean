  first | exact @GlobalTheory.BK.BKDat.Mon_mem_range_Lc | exact GlobalTheory.BK.BKDat.Mon_mem_range_Lc | (intros; apply GlobalTheory.BK.BKDat.Mon_mem_range_Lc <;> assumption)
