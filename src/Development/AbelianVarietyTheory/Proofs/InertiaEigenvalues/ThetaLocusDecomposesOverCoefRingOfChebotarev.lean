theorem zDecomp_of_cheb : GlobalTheory.TwSys.Cheb → ∀ (D : D7), GlobalTheory.BlockComplement.GaloisRepsCusp D →
    ∀ i : D.nd.Loc, ZDecomp D.nd i := by
  intro hC D hG i π hπ r hr
