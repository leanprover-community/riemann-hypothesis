    fjKer ψ J.d B.o B.ζ s.om₀ (flatBF s Ψ) h₀ n h' =
      ∫ v : UX D ρ, star (psiUni ψ v.1) * fjKer ψ J.d B.o B.ζ s.om₀ (ev s Ψ (xZero J.d ⬝ v.1.1)) h₀ n h' ∂s.vU.ν := by
