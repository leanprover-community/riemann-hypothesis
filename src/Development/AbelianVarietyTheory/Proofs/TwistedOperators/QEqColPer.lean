    GlobalTheory.MixPer.JacHom.jacT_mul ψ J.d B.V₀ _ (fun u hu => yZero_mul B.V₀ _ hu) hγ hn,
    ← ev_jac s hom (s.weil.om_pres _ _ hΨ) v hn]
