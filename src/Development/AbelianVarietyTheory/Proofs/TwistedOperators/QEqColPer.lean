theorem ker_bound {Ψ : WO B.V J.W → ℂ} (hΨ : IsThetaFunO ψ B.V J.W Ψ) : ∃ M : UX D ρ → ℝ, Integrable M s.vU.ν ∧
    ∀ (v : UX D ρ) h₀, ∀ n ∈ flagN J.d, ∀ h',
      ‖star (psiUni ψ v.1) * fjKer ψ J.d B.o B.ζ s.om₀ (ev s Ψ (xZero J.d ⬝ v.1.1)) h₀ n h'‖ ≤ M v := by
