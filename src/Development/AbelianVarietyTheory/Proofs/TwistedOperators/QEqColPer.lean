    Module.End.one_apply] at h

theorem ev_core {Ψ : WO B.V J.W → ℂ} (hΨ : IsThetaFunO ψ B.V J.W Ψ) (v : UX D ρ) (h₀ : GA D B.A) (h' : GA D J.W₀) :
