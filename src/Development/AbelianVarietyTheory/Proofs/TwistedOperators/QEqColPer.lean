    (ev_theta s (s.weil.om_pres _ _ (s.weil.om_pres _ _ hΨ)) _)

theorem ker_flat {Ψ : WO B.V J.W → ℂ} (hΨ : IsThetaFunO ψ B.V J.W Ψ) (h₀ : GA D B.A) {n : GA D J.W}
