  ⟨0, fun _ _ _ => ⟨0, fun _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ s ch _ _ t _ hj g =>
    GlobalTheory.RowRep.exists_hasLoc s.core.lev ch.S.B t hj g⟩⟩

