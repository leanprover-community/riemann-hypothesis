  exact h fun τ => ⟨y τ, hy τ (Set.mem_univ τ)⟩

theorem tensor_ext {x y : ⨂[ℂ] τ, M.H τ} (h : ∀ u : M.Vec, ellT M (fun τ => u τ) x = ellT M (fun τ => u τ) y) :
