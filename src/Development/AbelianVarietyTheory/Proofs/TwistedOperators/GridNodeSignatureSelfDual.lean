theorem negIdx_of_sig {D : D7} (V : HSp D) (q : ℕ) (h : V.SigOK) (hs : ∀ τ : D.host.E →+* ℂ, V.sig τ = (V.rank - q, q)) :
    NegIdx V q := fun τ => by
  have := h (tauE D τ)
  rw [hs] at this
  exact this

