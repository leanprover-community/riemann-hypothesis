  first | exact @GlobalTheory.ZM.exists_isGaloisCover_of_isQProjOver | exact GlobalTheory.ZM.exists_isGaloisCover_of_isQProjOver | (intros; apply GlobalTheory.ZM.exists_isGaloisCover_of_isQProjOver <;> assumption)
