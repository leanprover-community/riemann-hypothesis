  first | exact @GlobalTheory.KTrivSpread.exists_kTriv_of_isUnit | exact GlobalTheory.KTrivSpread.exists_kTriv_of_isUnit | (intros; apply GlobalTheory.KTrivSpread.exists_kTriv_of_isUnit <;> assumption)
