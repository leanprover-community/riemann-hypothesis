  first | exact @GlobalTheory.FormBundleKer.eq_one_of_slice_trivial | exact GlobalTheory.FormBundleKer.eq_one_of_slice_trivial | (intros; apply GlobalTheory.FormBundleKer.eq_one_of_slice_trivial <;> assumption)
