  first | exact @GlobalTheory.KS.DimPEL.finrank_symm_comm_le | exact GlobalTheory.KS.DimPEL.finrank_symm_comm_le | (intros; apply GlobalTheory.KS.DimPEL.finrank_symm_comm_le <;> assumption)
