  first | exact @GlobalTheory.SW.DblAdm.adm_dbl_phi_of_isVac | exact GlobalTheory.SW.DblAdm.adm_dbl_phi_of_isVac | (intros; apply GlobalTheory.SW.DblAdm.adm_dbl_phi_of_isVac <;> assumption)
