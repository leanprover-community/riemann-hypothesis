  first | exact @GlobalTheory.StrataBertini.bertini_strata_cotangent | exact GlobalTheory.StrataBertini.bertini_strata_cotangent | (intros; apply GlobalTheory.StrataBertini.bertini_strata_cotangent <;> assumption)
