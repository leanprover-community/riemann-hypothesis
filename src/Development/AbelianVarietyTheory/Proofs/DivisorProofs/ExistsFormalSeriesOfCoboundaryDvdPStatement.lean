  first | exact @GlobalTheory.QLog.exists_series_of_cobOne_dvd | exact GlobalTheory.QLog.exists_series_of_cobOne_dvd | (intros; apply GlobalTheory.QLog.exists_series_of_cobOne_dvd <;> assumption)
