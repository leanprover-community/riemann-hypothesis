    dualVecInf E n ζ j w = (-(ζ (unitVecInf j w 1) : ℂ) + Complex.I * (ζ (unitVecInf j w Complex.I) : ℂ)) / 2 := rfl

theorem eq_sum_unitVecInf (v : Fin n → Cinf E) :
