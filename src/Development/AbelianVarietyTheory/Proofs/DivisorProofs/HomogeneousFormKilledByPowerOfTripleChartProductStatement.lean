  first | exact @GlobalTheory.FormalAlg.TripleKill.ev_triple_kill | exact GlobalTheory.FormalAlg.TripleKill.ev_triple_kill | (intros; apply GlobalTheory.FormalAlg.TripleKill.ev_triple_kill <;> assumption)
