  obtain ⟨pr, w, hmon, huniv, -⟩ := h
  have lim : IsLimit (Fan.mk D.P.A pr) :=
    mkFanLimit _ (fun s => (huniv s.pt s.proj).choose)
      (fun s i => (huniv s.pt s.proj).choose_spec.1 i)
