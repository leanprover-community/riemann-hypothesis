theorem abLocus_eq (X S : Scheme.{0}) (j : X ⟶ S) (G : Over S) [GrpObj G] (hG : IsSemiAbelian G)
    (hc : ∀ (x : S), ∃ (R : Type) (_ : CommRing R) (_ : IsLocalRing R) (ξ : Sp R ⟶ S) (G₁ : Over (Sp R)) (_ : GrpObj G₁)
