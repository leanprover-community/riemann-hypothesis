  have h := abLocus_pullback abLocusOne hG hp.1 (closedPoint R)
  rw [hx] at h
  have h' := hab (closedPoint R)
  rw [hx] at h'
  exact h.trans h'

theorem relDim (X S : Scheme.{0}) (j : X ⟶ S) [IsOpenImmersion j] (hj : IsDominant j) (A : Over X) [GrpObj A]
