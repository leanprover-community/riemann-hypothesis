  first | exact @GlobalTheory.FieldPair.adjKlt_of_klt_restrict | exact GlobalTheory.FieldPair.adjKlt_of_klt_restrict | (intros; apply GlobalTheory.FieldPair.adjKlt_of_klt_restrict <;> assumption)
