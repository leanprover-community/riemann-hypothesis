      (a (.inl i) * b (.inr i) - a (.inr i) * b (.inl i))) Finset.univ)
  have hi : ∀ (p : Prop) [Decidable p] (u : U) (m : ℤ), (if p then u else 1) ^ m = if p then u ^ m else 1 :=
