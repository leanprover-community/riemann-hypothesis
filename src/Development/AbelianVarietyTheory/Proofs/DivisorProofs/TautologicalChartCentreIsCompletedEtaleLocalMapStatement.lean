theorem isAlgebraic_of_quasiFinite (A K : Type) [CommRing A] [IsDomain A] [Field K] [Algebra A K] [FaithfulSMul A K]
    [Algebra.QuasiFinite A K] : Algebra.IsAlgebraic A K := by
