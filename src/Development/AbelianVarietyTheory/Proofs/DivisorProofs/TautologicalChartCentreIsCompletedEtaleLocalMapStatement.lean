  rw [smul_zero, Algebra.smul_def, _root_.mul_one]
  exact h0

theorem psi_mem_closure (C : TChart.Taut ζ g n φ) (a : MvPolynomial (Fin C.m ⊕ Fin C.N) C.W) :
