  first | (exact @GlobalTheory.UPel.HT.ESPull.isPIsog_pull) | (exact GlobalTheory.UPel.HT.ESPull.isPIsog_pull) | (intros; apply GlobalTheory.UPel.HT.ESPull.isPIsog_pull  <;> assumption)
