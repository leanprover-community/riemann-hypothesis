  first | exact @GlobalTheory.Mum.Two.Mix.exists_mix_hom | exact GlobalTheory.Mum.Two.Mix.exists_mix_hom | (intros; apply GlobalTheory.Mum.Two.Mix.exists_mix_hom <;> assumption)
