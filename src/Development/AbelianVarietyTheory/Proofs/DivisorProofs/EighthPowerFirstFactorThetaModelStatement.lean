  have hz : z = 1 := mul_eq_left.1 (Over.OverMorphism.ext h)
  have h1 : φ₀ ≫ (1 : G ⟶ G) = 1 := MonObj.comp_one _
  have h2 : z.left = (φ₀ ≫ (1 : G ⟶ G)).left := congrArg (fun w => w.left) (hz.trans h1.symm)
