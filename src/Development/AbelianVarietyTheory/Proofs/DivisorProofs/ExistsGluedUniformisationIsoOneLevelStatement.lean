  first | exact @GlobalTheory.Mum.Two.GlueLevel.exists_iso_level | exact GlobalTheory.Mum.Two.GlueLevel.exists_iso_level | (intros; apply GlobalTheory.Mum.Two.GlueLevel.exists_iso_level <;> assumption)
