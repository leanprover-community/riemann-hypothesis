theorem eq_zero_of_lifts (hε : IsDiagEnd F W X₁.ρ.P X₁.u ε₁) (D : Deep X₁ ε₁) {p : ℕ} [Fact p.Prime] {z₁ : X₁.M.Z}
    {z₂ : D.X.M.Z} (hz : D.q z₂ = z₁) (y₀ : Sp (OO p) ⟶ D.X.M.Z) (h₀ : y₀ (cPt p) = z₂) {b : D.X.Ω₁}
