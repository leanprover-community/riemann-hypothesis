    exact ⟨(spMap D.X.S.R.val.toRingHom ≫ D.X.u) (closedPoint D.X.Ω₁), rfl⟩
  · obtain ⟨c, hc⟩ := GlobalTheory.Poinc.GCTrait.exists_cTrait g n F W Z i X₁ X₁.one_le X₁.three_le X₁.odd X₁.imm p (y ≫ D.q) (by
      rw [Category.assoc, D.comp]
