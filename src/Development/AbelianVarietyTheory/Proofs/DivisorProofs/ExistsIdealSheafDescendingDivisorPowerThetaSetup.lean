theorem exists_iso (D : Deep X₁ ε₁) {p : ℕ} [Fact p.Prime] {z₁ : X₁.M.Z} (c c' : CTrait X₁ p z₁)
    {y y' : Sp (OO p) ⟶ D.X.M.Z} (h : y ≫ D.q = c.y) (h' : y' ≫ D.q = c'.y) (hc : y' (cPt p) = y (cPt p))
