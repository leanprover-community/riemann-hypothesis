  first | exact @GlobalTheory.abs_norm_det_gram_eq_relIndex | exact GlobalTheory.abs_norm_det_gram_eq_relIndex | (intros; apply GlobalTheory.abs_norm_det_gram_eq_relIndex <;> assumption)
