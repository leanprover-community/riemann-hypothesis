  first | exact @GlobalTheory.WhitBump.FinBump.bumpFin_props | exact GlobalTheory.WhitBump.FinBump.bumpFin_props | (intros; apply GlobalTheory.WhitBump.FinBump.bumpFin_props <;> assumption)
