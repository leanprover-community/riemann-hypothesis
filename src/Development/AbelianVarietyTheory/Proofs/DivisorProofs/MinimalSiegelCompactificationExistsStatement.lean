theorem valF_pt_ne_zero (M : RatModel o Ω) {V : M.Z.Opens} (hV : (V : Set M.Z).Nonempty) (u : Γ(M.Z, V)ˣ) :
    valF M.pt V (u : Γ(M.Z, V)) ≠ 0 := by
  rw [← M.res_apply V hV]
