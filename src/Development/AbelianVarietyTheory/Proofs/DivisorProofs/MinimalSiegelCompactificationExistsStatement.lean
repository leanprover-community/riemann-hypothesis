      (LB.LinComb L (K := PUnit) (fun _ => φ) (fun _ => n)).U P')
      (((LB.LinComb L (K := PUnit) (fun _ => φ) (fun _ => n)).g P P' : Γ(M.Z, _)ˣ) : Γ(M.Z, _)) =
      valF (M.pt ≫ φ) (L.U (P PUnit.unit) ⊓ L.U (P' PUnit.unit)) (L.g (P PUnit.unit) (P' PUnit.unit) : Γ(Y, _)) ^ n := by
