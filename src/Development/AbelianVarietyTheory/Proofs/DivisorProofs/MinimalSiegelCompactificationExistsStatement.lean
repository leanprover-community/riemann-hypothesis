theorem valF_pt_inv (M : RatModel o Ω) {V : M.Z.Opens} (hV : (V : Set M.Z).Nonempty) (u : Γ(M.Z, V)ˣ) :
    valF M.pt V (↑u⁻¹ : Γ(M.Z, V)) = (valF M.pt V (u : Γ(M.Z, V)))⁻¹ := by
  rw [← M.res_apply V hV, ← M.res_apply V hV]
