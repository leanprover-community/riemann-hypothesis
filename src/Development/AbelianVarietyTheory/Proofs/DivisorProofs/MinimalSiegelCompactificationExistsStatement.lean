  · intro p hp
    have hW := top_le_wchart L x p hp
    refine ⟨_root_.GlobalTheory.ZH.FrameNorm.val_unit_ne_zero _ hW _, fun i => ?_⟩
    have e := congrArg (valR (𝟙 (Sp K)) _) (hv i (fun _ => p) (LB.wchart_le L (fun _ => x) (fun _ => p) PUnit.unit))
