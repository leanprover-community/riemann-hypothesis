    ∃ c : L.ι → K, (∀ p, ⊤ ≤ x ⁻¹ᵁ L.U p → c p ≠ 0 ∧ ∀ i, valF x (L.U p) ((σ i).f p) = v i * c p) ∧
      ∀ p p', ⊤ ≤ x ⁻¹ᵁ (L.U p ⊓ L.U p') →
