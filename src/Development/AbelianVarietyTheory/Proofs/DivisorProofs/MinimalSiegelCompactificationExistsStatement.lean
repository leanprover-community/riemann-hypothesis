theorem valF_linComb_g (M : RatModel o Ω) {Y : Scheme.{0}} (L : LB Y) (φ : M.Z ⟶ Y) (n : ℤ) (P P' : PUnit → L.ι)
    (hV : (((LB.LinComb L (K := PUnit) (fun _ => φ) (fun _ => n)).U P ⊓
      (LB.LinComb L (K := PUnit) (fun _ => φ) (fun _ => n)).U P' : M.Z.Opens) : Set M.Z).Nonempty) :
