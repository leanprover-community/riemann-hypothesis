  have hl : ∀ a, (lev' a).left ≫ ψ = spMap (algebraMap O K) ≫ (lev a).left := fun a => (hlev a).symm
  let J : Over.mk ((𝟙_ (Over (Sp K))).hom ≫ spMap (algebraMap O K)) ⟶ 𝟙_ (Over (Sp O)) := toUnit _
