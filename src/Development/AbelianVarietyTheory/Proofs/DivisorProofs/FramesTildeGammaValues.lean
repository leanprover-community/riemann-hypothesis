    (mtildeK_rat W Ch sel t.1 hX) v F'
  have hE := GlobalTheory.T.classSum_principalLevel_eq_card_mul_classSum W Ch sel t.1 P hX v F' hF'
  have hN := GlobalTheory.ClassSumLevel.normAt_sq_of_frame _ X0 v F hframe
