variable {k : Type} [Field k] {Y : Scheme.{0}} {p : Y ⟶ Sp k} {B : LB Y}

def Centred (y : Y) (ν : Valuation (Y.presheaf.stalk y) (WithZero (Multiplicative ℤ))) : Prop :=
  (∀ a, ν a ≤ 1) ∧ (∀ a ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y), ν a < 1) ∧ ∀ a, ν a = 0 → a = 0

