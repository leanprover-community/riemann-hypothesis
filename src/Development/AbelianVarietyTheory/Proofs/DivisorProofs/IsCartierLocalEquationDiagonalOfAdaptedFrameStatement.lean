  first | exact @GlobalTheory.FlagPush.isEqn_diag_of_frame | exact GlobalTheory.FlagPush.isEqn_diag_of_frame | (intros; apply GlobalTheory.FlagPush.isEqn_diag_of_frame <;> assumption)
