  first | (exact @GlobalTheory.DiagAmpleLocus.diag_relAmple_locus) | (exact GlobalTheory.DiagAmpleLocus.diag_relAmple_locus) | (intros; apply GlobalTheory.DiagAmpleLocus.diag_relAmple_locus  <;> assumption)
