  first | exact @GlobalTheory.CMVal.Euler.exists_split_unif_idele | exact GlobalTheory.CMVal.Euler.exists_split_unif_idele | (intros; apply GlobalTheory.CMVal.Euler.exists_split_unif_idele <;> assumption)
