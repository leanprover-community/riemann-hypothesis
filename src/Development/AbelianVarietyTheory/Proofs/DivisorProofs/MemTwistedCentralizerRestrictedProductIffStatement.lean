  first | exact @GlobalTheory.EulerAbs.mem_twCent_iff_forall_comp | exact GlobalTheory.EulerAbs.mem_twCent_iff_forall_comp | (intros; apply GlobalTheory.EulerAbs.mem_twCent_iff_forall_comp <;> assumption)
