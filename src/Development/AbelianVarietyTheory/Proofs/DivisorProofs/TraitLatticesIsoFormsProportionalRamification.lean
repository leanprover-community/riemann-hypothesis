    ∃ E : G₁ ≅ G₂, IsMonHom E.hom ∧ (Over.pullback (jK W)).map E.hom = e.hom := by
  obtain ⟨F, ⟨hF, hF'⟩, -⟩ := GlobalTheory.semiAbelian_hom_extends_uniquely_dvr W (FractionRing W) G₁ G₂ h₁ h₂ e.hom he
  obtain ⟨F₁, ⟨hF₁, hF₁'⟩, -⟩ :=
