  refine ⟨⟨F, F₁, ?_, ?_⟩, hF, hF'⟩
  · exact (GlobalTheory.semiAbelian_hom_extends_uniquely_dvr W (FractionRing W) G₁ G₁ h₁ h₁ (𝟙 _) inferInstance).unique
