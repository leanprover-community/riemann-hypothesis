theorem cong_of_mk_eq {X : Type} [AddCommGroup X] (hX : ∀ (d : ℕ) (x : X), d ≠ 0 → d • x = 0 → x = 0) {d L M : ℕ}
    (hd : d ≠ 0) (hM : M = d * L) {μ ν : Fin 8 → X}
