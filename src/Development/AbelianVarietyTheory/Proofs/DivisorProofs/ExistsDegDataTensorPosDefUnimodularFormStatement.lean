      (cubV Q.cub y J (toUnit (TK R) ≫ Q.c (xe x i)) (toUnit (TK R) ≫ Q.c (-(xe x i))) (toUnit (TK R) ≫ Q.c (xe x j)) *
        (cubV Q.cub y J (toUnit (TK R) ≫ Q.c (xe x j)) (toUnit (TK R) ≫ Q.c (-(xe x j)))
          (toUnit (TK R) ≫ Q.c (-(xe x i))))⁻¹) ^ W i j := by
