  intro B X I hOk hPins l Z L hT Gi Gl K Y cX ex t W Del h0 hS
  obtain ⟨hX, hseam, hPr, -, -, -, -, -, -, -, -, -, -, -, -⟩ := hS
  cases t
  dsimp only at *
  subst hX
  obtain rfl := eq_of_heq hPr
  obtain rfl := eq_of_heq hseam
  exact GlobalTheory.CoreHt.host_tie_trueCols I hOk l Z L

