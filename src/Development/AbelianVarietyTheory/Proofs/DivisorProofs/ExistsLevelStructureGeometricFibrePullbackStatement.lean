  first | exact @GlobalTheory.Mum.FibLevel.exists_level_of_pullback | exact GlobalTheory.Mum.FibLevel.exists_level_of_pullback | (intros; apply GlobalTheory.Mum.FibLevel.exists_level_of_pullback <;> assumption)
