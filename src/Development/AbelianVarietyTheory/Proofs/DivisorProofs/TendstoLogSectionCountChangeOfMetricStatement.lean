  first | exact @GlobalTheory.HSAmp.tendsto_logCount_sub_up | exact GlobalTheory.HSAmp.tendsto_logCount_sub_up | (intros; apply GlobalTheory.HSAmp.tendsto_logCount_sub_up <;> assumption)
