  first | exact @GlobalTheory.AbLaw.FibreLift.exists_pull_eq_smul | exact GlobalTheory.AbLaw.FibreLift.exists_pull_eq_smul | (intros; apply GlobalTheory.AbLaw.FibreLift.exists_pull_eq_smul <;> assumption)
