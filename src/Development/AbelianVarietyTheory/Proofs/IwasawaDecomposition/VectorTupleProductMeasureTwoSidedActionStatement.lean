  first | exact @GlobalTheory.GaugeEx.ModDet.tupMeas_lrAct | exact GlobalTheory.GaugeEx.ModDet.tupMeas_lrAct | (intros; apply GlobalTheory.GaugeEx.ModDet.tupMeas_lrAct <;> assumption)
