  first | exact @GlobalTheory.MuZeroCong.locK_eq_of_sub_mem | exact GlobalTheory.MuZeroCong.locK_eq_of_sub_mem | (intros; apply GlobalTheory.MuZeroCong.locK_eq_of_sub_mem <;> assumption)
