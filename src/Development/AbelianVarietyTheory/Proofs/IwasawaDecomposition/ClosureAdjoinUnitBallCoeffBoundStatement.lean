  first | exact @GlobalTheory.closure_adjoin_unitBall_coeff_bound | exact GlobalTheory.closure_adjoin_unitBall_coeff_bound | (intros; apply GlobalTheory.closure_adjoin_unitBall_coeff_bound <;> assumption)
