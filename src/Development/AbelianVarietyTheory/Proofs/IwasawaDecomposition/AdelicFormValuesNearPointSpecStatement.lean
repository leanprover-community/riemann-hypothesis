  first | exact @GlobalTheory.LevelHecke.ValAt.valAt_spec | exact GlobalTheory.LevelHecke.ValAt.valAt_spec | (intros; apply GlobalTheory.LevelHecke.ValAt.valAt_spec <;> assumption)
