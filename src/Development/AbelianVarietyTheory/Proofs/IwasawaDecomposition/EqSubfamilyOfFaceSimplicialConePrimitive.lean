    ∃ s : Fin n ↪ Fin m, (∀ j, γ j = δ (s j)) ∧ ∀ i, h (δ i) = 0 ↔ i ∈ Set.range s := by
  atlas_forward_decl GlobalTheory.PolFan.eq_subfamily_of_face
