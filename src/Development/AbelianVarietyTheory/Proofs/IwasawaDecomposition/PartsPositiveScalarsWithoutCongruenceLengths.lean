    {Y : Read (A3 := A3) R.toRealDat F.lv2 X0} (Z : GlobalTheory.Mem.R3.Rw.RationalReadingWithoutCongruence R F X0 Y) : Prop :=
  ∃ cOf : D.what₂.FT → A3.fam3.base3.Ix,
    (∀ (i : Fin D.R.m) (c : A3.fam3.base3.Ix),
