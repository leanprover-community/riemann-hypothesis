        Submodule.span ℂ ((Z.jW i) '' ((s0Of R F).Wp i c : Set (Fin ((s0Of R F).dW i) → D.what₂.LL)))) ∧
    (∀ (i : Fin D.R.m) (t : T) (σ : D.what₂.FT),
