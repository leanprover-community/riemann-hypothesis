  first | exact @GlobalTheory.Reg.birSt_of_ratios_trdeg | exact GlobalTheory.Reg.birSt_of_ratios_trdeg | (intros; apply GlobalTheory.Reg.birSt_of_ratios_trdeg <;> assumption)
