  first | exact @GlobalTheory.Unfold.IotaLocal.iotaGraph_eq_of_gdat | exact GlobalTheory.Unfold.IotaLocal.iotaGraph_eq_of_gdat | (intros; apply GlobalTheory.Unfold.IotaLocal.iotaGraph_eq_of_gdat <;> assumption)
