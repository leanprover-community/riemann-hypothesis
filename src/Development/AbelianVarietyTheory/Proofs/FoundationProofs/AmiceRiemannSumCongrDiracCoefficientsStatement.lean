  first | exact @GlobalTheory.KZ.Cmp.RiemannDirac.rSum_cg | exact GlobalTheory.KZ.Cmp.RiemannDirac.rSum_cg | (intros; apply GlobalTheory.KZ.Cmp.RiemannDirac.rSum_cg <;> assumption)
