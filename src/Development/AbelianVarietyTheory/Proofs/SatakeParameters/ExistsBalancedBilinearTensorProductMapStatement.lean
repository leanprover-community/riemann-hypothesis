  first | exact @GlobalTheory.LetterDescent.exists_letter_tensor_map | exact GlobalTheory.LetterDescent.exists_letter_tensor_map | (intros; apply GlobalTheory.LetterDescent.exists_letter_tensor_map <;> assumption)
