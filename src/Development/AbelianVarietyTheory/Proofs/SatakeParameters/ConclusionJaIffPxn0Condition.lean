set_option maxHeartbeats 1000000 in
theorem _root_.GlobalTheory.T.inert_prime_ne_typePrime : ∀ (D : D7) (l : ℕ) (k : Fin 2), TwistedPlaces.InertK D l → l ≠ D.host.g k := by
  atlas_forward_decl GlobalTheory.InertNotType.main
end

