  have hall : ∀ (n : flagN d) (h : GA D W) (S : Set (Matrix (Fin W.rank) (Fin ρ) D.host.E)),
      ∑' y : S, ‖Th n.1 * G h * term ψ d W vS (om (n.1, h) Φ) y.1‖ₑ ≤ ENNReal.ofReal (M * (max C 0 * B)) := by
