        DblLat (c.B j (σ + 1) h) (c.J j (σ + 1) h) (c.B (j + 1 + 1) σ (idx_step h))) (offP v w) o.q
      ⟨o.β j, o.β₀ j (σ + 1) h, o.Q j⟩ ⟨o.β (j + 1), o.Q (j + 1)⟩
      ⟨o.β (j + 1 + 1), o.β₀ (j + 1 + 1) σ (idx_step h), o.Q (j + 1 + 1)⟩ :=
    { inj := hS.pre.inj
