    · exact hon.linearIndependent.map' (vecOf (n := n)).symm.toLinearMap
        (LinearMap.ker_eq_bot.2 (vecOf (n := n)).symm.injective)
    · intro X hX
      exact ⟨_, hexpM X hX⟩
    · intro k hk
      have hkG : k ∈ G := hk.1
      have hkU : k ∈ Matrix.unitaryGroup (Fin n) ℂ := hk.2
