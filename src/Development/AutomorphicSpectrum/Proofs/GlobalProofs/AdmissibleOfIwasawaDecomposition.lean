  (1 / 2 : ℝ) • (Y - Jε ε * Yᴴ * Jε ε)

theorem inG_projJ (ε : Fin n → Bool) (Y : Matrix (Fin n) (Fin n) ℂ) : ReciprocityTheory.ChartRestriction.DS.inG ε (projJ ε Y) := by
