theorem main : ∀ {K : Type} [Field K] {X : Scheme.{0}} (D : E.LineData X) (N : ℕ) (i : X ⟶ PSpace K N),
    IsTautologicalLineAt D N i → ∀ j, wch i j ∈ 𝒱D D :=
  fun D N i h j => GlobalTheory.CompanionTheory.ConeChart.preimage_chart_mem D N i h j

