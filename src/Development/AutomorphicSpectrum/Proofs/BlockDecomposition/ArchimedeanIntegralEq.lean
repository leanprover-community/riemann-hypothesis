theorem exists_lift (hPh : ReciprocityTheory.ChartRestriction.G.Geo.IsMultiHomogIdeal (ptIdeal (i (genericPoint X))))
    (c : GlobalTheory.AlgChart (i ≫ mpStr ℤ m n) σ₀ D) {y : GlobalTheory.CxPts (i ≫ mpStr ℤ m n) σ₀} :
