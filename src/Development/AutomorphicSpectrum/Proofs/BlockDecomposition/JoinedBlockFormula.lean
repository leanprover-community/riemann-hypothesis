theorem jnBl : JnBl := by
  intro D n t a r hn w v y
  unfold jn PositivityTheory.Rg.Rsw.L.mm
  rw [show bl hn (1 : Mx D r r) y (0 : Mx D t r) (1 : Mx D t t) =
      (Matrix.fromBlocks (1 : Mx D r r) y (0 : Mx D t r) (1 : Mx D t t)).submatrix
