  intro E _ _ _ H D l Xo c Y S₀ S M₀ M₁ Rf Sys Fx o₀ o₁ oR hS hdisc hv₀ hv₁ hRR hdeg
  have hmono : Mono (spMap (algebraMap (𝓞 c.F) c.F)) := mono_int' c
