  first | exact @GlobalTheory.CompanionTheory.Ar.LieModel.isHTAt_end | exact GlobalTheory.CompanionTheory.Ar.LieModel.isHTAt_end | (intros; apply GlobalTheory.CompanionTheory.Ar.LieModel.isHTAt_end <;> assumption)
