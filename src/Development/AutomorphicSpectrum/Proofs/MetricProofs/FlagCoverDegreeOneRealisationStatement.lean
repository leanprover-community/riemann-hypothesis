theorem _root_.GlobalTheory.T.flag_cover_degree_one_realisation : ∀ (K : Type) [Fintype K] (ι : K → Type) [∀ k, Fintype (ι k)] (Φ : Type) [Field Φ] (y : (Σ k, ι k) → Φ) (Ψ : Type) [Fintype Ψ] [DecidableEq Ψ] (N j : ℕ) (M : FlagModel y Ψ N j) (n d : ℕ) (BM : BaseMetric M n) (FA : FlagAn BM d), ∃ (Cv : FlagCover M M) (CR : CovReal FA Cv), Cv.deg = 1 ∧ (∀ p, CR.Re.ref p = FA.Re.ref (some p)) ∧ ∀ p t, CR.Re.line p t = FA.Re.line (some p) t := by
  first | exact @GlobalTheory.CompanionTheory.Ar.PB.identity_cover | exact GlobalTheory.CompanionTheory.Ar.PB.identity_cover | (intros; apply GlobalTheory.CompanionTheory.Ar.PB.identity_cover <;> assumption)
