  have lB : ∀ τ, ∀ Y ∈ lieAt WW τ, ∀ x, EB (rl₀ τ Y x) = rl τ Y (EB x) := fun τ Y hY =>
    intertwine _ p₀' p' EB hEB hm₀.mapB.onto _ _ fun Φ hΦ => by
