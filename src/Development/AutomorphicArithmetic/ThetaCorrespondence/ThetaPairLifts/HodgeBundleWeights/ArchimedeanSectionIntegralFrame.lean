  intro hP hQ2 E _ _ _ H Dw l Xo c r U x hL Z τ _
  obtain ⟨Y, V, sig, hV, hs, hnv, hh⟩ := _root_.GlobalTheory.T.detLine_period_flat hP hQ2 E H Dw l Xo c r U x hL Z τ
