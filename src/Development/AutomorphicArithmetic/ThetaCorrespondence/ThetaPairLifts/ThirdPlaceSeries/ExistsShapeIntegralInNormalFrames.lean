  intro j ρ h
  obtain ⟨ΛL, hΛL⟩ := hline ρ j h
  have hA : SelfDualFor (D.sp.X j).gram (a.x j).L := (isSelfDualC_iff _ _).1 (hIs.x j (by omega)).sd
