  refine GlobalTheory.Fc.EvP.of_all fun _ K _ q c b w _ => ?_
  have hR : b.R.T.n.cf = GlobalTheory.Mem.Col2.TC.cf q.w.I q.w.l q.Z := congrArg Sigma.fst w.recPin.s.chr
