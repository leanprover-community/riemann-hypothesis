    ((HomologicalComplex.ιMapBifunctor I J (tF R) (ComplexShape.up ℤ) p.1.1 p.1.2 w p.2).app (op U)).hom

theorem Phi_lof (I J : Cx R) (U : Scheme.{0}) (w : ℤ) (p : {p : ℤ × ℤ // p.1 + p.2 = w})
