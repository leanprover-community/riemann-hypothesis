@[expose] public section

theorem UpperTheory.Reformulated.B.Qn14.le_of_add_one_le_succ :
    ∀ {a : WithBot ℕ∞} {k : ℕ},
    a + (1 : WithBot ℕ∞) ≤ (↑(k + (1 : ℕ)) : WithBot ℕ∞) → a ≤ (↑k : WithBot ℕ∞) := by
  intro a k h
  cases a with
  | bot => exact bot_le
  | coe a =>
    have h1 : a + 1 ≤ ((k + 1 : ℕ) : ℕ∞) := WithBot.coe_le_coe.1 h
    rw [Nat.cast_add, Nat.cast_one] at h1
    exact WithBot.coe_le_coe.2 ((ENat.add_le_add_iff_right ENat.one_ne_top).1 h1)
