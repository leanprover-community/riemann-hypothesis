  refine ⟨normOneMeasure_normOneFundamentalDomain_lt_top E,
    measurableSet_normOneFundamentalDomain E, ?_⟩
  have hc : Continuous (fun z : ↥(IdeleGroup.normOneSubgroup E) =>
      ((z : IdeleGroup E) : (A E)ˣ)) := continuous_subtype_val
