def SWAniso_k : Prop :=
  ∀ (F E : Type) [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E] (σ : E →ₐ[F] E) (B : Base F E) (m n : ℕ) (A : Spc F E m) (Y : Spc F E n) (M : Model σ A Y) r s r' s', _root_.UpperTheory.TP.W.GoodK σ B → 1 ≤ m → 1 ≤ n → A.IsHerm σ B r s →
