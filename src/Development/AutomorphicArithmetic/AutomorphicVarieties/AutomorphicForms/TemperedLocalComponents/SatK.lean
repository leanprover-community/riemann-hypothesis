theorem UpperTheory.V.Af.satK :
    UpperTheory.V.Af.Hypotheses₂ → UpperTheory.V.Af.SatK := by
  intro P K _ _ _ n M π hπ w hw
  obtain ⟨⟨σ, hσ⟩, h⟩ := locCompC P K n π w
  exact sat_of_isotypic (satLoc P) π.finPart hπ w hw σ (h σ hσ)
