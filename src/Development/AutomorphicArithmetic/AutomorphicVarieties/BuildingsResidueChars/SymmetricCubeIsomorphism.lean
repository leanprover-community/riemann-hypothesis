private theorem diag_mul {R : Type} [CommRing R] {u : R} (hu : 3 * u = 1) :
    (Matrix.diagonal ![1, 1, -1, 3] * Matrix.diagonal ![1, 1, -1, u] : M4 R) = 1 := by
  rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
  congr 1
  ext i
  fin_cases i <;> simp [hu]
