theorem UpperTheory.V.Br.repEig_of_printsH_of_hermEx :
    _root_.UpperTheory.V.Af.HypothesesH' → UpperTheory.V.Af.Gk.HermEx → UpperTheory.V.Br.RepEig := by
  intro P hH k hk π hπ
  have hk1 : 1 ≤ k := by omega
