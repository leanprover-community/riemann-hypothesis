theorem spherical_same_of_z_eq : ZEq → _root_.UpperTheory.V.Z.J.D.SphSameAlt := by
  intro hZ hLit l _ L Ω _ _ _ _ _ _ s n hn V hV Q c ι m τ₀ lam d e ξ hξ A _ _ _ θ x c0 sp hWt hSp K ev hev σ σ' hσ hσ' hcp hne
