  rw [class_eq_finite_length_class β h, class_eq_finite_length_class α hα, class_eq_finite_length_class γ hγ, clsGL, clsGL, clsGL, cls_exact i q hi hq he h hα hγ,
    Finsupp.mapDomain_add]

