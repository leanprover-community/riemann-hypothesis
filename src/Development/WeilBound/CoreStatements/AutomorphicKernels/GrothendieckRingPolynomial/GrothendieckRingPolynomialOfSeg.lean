  rw [← h1]
  have e1 : (List.ofFn fun i => decW (Γ i.rev)) = (List.ofFn fun i => Γ i.rev).map decW := by
    rw [List.map_ofFn]
    rfl
  rw [e1, tri_coe_flatten_decW, ← GlobalTheory.CompanionTheory.ZcWords.reverse_ofFn, Multiset.coe_reverse, Fin.univ_val_map]

