  rw [T_D_dg (mem_sch hΦ) h1, T_D_dg (mem_sch hΦ) h2, e X]
  field_simp

theorem mul_pol (R : RD d) (w : InfinitePlace F) (Q : PX d.m d.n) {f : Mx F E d.m d.n → ℂ} (hf : f ∈ TK d) :
    (fun X => evX Q (R.loc w X) * f X) ∈ TK d := by
