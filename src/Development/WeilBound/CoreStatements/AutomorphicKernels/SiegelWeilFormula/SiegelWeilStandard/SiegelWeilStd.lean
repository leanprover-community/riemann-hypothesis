  refine ⟨(continuous_cj hU h.1 v).measurable, ?_⟩
  have hl := latHaar (nA σ d.Y d.b) lam (nF σ d.Y d.b) (cjE hU h.1 v) (fun x => ⟨fun hx => ?_, fun hx => cj_rat hU h.1 hv hx⟩)
