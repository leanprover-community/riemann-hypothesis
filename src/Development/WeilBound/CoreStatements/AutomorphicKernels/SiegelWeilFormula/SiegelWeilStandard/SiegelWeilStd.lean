  have hinv : GlobalTheory.AutomorphicL2Unitary.LeftInv (par2 σ L.Y ⊓ rat2 σ L.Y) (fun y : G2 σ L.Y => phz d f s₁ z (L.j y * x)) := by
    intro γ hγ g
