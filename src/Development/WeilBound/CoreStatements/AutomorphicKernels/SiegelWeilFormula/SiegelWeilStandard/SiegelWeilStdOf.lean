theorem siegelWeilStd_of (hT : TAll) (hLI : LocInst) (hGD : GIdil) (hKP : KFinPoly) (hPK : PolyKFin) (hLD : LDEx)
    (hCT : CTSplit) (hH : HolLead) : SiegelWeilStd := by
