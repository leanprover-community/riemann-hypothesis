    rw [pow_sub_of_sq c hc (m + 1) m (by omega)]
    have h1 : m + 1 - m = 1 := by omega
    rw [h1]
    push_cast
    rw [show -(2 * (0 : ℂ) + (m + 1) - m) = -1 by ring, Complex.cpow_neg_one, zpow_one, div_eq_mul_inv]

