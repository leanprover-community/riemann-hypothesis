theorem vg_K' (hO : LocOpEx) (hI : LocInst) (hA : FinAct) (R : RD d)
    {g : (Fin d.m × Fin d.n × Fin 2 → Af F) → ℂ} (hg : g ∈ SB _) {Φ : d.Fn} (hΦ : Φ ∈ d.sch) (hT : d.T Φ = vg R g)
