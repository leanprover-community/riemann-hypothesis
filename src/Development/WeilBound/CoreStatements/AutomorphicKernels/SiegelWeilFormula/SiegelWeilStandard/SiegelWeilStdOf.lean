    simp only [Module.End.mul_apply, map_smul, smul_eq_mul] at e2
    rw [d.ok.dbl.fix g _ (hsp p _ ((hS d).pres _ _ hφl)), K _ ((hS d).pres _ _ hφl), d.ok.dbl.fix g⁻¹ φl hφl,
      K φl hφl] at e2
