theorem tthetaComm (hT : TBij) : ∀ (F E : Type) [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E]
    (σ : E →ₐ[F] E) (d : SD σ), ∀ Φ ∈ d.sch, ∀ x g, d.om x (d.S g Φ) = d.S g (d.om x Φ) :=
  fun _ _ _ _ _ _ _ _ d Φ hΦ x g => comm d hT g Φ hΦ x

