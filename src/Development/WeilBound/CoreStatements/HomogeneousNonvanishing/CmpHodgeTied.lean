  have h0 : φ.hom a = 0 := by
    by_contra h
    exact (IsLocalRing.mem_maximalIdeal _).1 ha (isUnit_iff_ne_zero.2 h)
  rw [show a = 0 from hφ (by rw [h0, map_zero])]
