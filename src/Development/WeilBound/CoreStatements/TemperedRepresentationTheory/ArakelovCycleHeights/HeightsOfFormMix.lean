theorem exists_partition {P : Scheme.{0}} {q : P ⟶ Sp k} {N : ℕ} {σ : k →+* ℂ} (R : AnRead q σ N)
    [CompactSpace (CxPts q σ)] [T2Space (CxPts q σ)] {J : Type} (V : J → Set (CxPts q σ)) (hV : ∀ j, IsOpen (V j))
