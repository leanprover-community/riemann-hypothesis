      Real.log (‖gv q ((starRingEnd ℂ).comp σ) B c c' (conjPts q rfl y)‖ ^ 2) =
        Real.log (‖gv q σ B c c' y‖ ^ 2) := by
    intro σ c c' y hy
    unfold CxPts.gv
    rw [ev_conj rfl hy, Complex.norm_conj]
