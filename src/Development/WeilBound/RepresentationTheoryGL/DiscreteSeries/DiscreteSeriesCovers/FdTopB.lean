    mexp ε (m₁ + m₂) a = mexp ε m₁ a + mexp ε m₂ a := by
  unfold mexp
  split_ifs with h
  · simp only [Pi.add_apply]; ring
  · simp only [Pi.add_apply]

theorem model_functions_multiply : ModelFunctionsMultiply := by
  intro n ε m₁ m₂ h₁ h₂ k
