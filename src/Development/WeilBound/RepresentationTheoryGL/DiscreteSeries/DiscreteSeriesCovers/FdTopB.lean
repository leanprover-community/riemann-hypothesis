  T.dτ + LinearMap.smulRight (Matrix.traceLinearMap (Fin n) ℂ ℂ) ((c : ℂ) • (1 : T.V →L[ℂ] T.V))

theorem twTau_irred {ε : Fin n → Bool} {Λ : Fin n → ℝ} (T : KType ε Λ) (c : ℤ) (W : Submodule ℂ T.V)
