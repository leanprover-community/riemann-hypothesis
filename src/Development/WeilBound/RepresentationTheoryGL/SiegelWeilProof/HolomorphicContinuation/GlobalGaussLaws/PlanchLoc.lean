def PlanchLoc : Prop :=
  ∀ (m n : ℕ) (ε : Fin m → Bool) (t : ℝ), t ≠ 0 → ∃ c : ℝ, 0 < c ∧ ∀ f : (Fin m → Fin n → ℂ) → ℂ, IsSch f →
    ∫ u, ‖ftLoc ε t f u‖ ^ 2 = c * ∫ u, ‖f u‖ ^ 2

def AwayNZ : Prop :=
