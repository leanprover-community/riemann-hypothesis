  · have h1 := hχ.2 x
    have h2 := hη.2 x
    simp only [MonoidHom.mul_apply, MonoidHom.inv_apply, MonoidHom.pow_apply, h1, h2, one_pow, inv_one, mul_one]

theorem resEtaF_div_pow {χ η : (AF F ⊗[F] E)ˣ →* Circle} {n : ℕ} (hχ : ResEtaF χ n) (hη : ResEtaF η 1) :
