def evalHom (δ : G →* (X →L[ℂ] X)) (ρ : G →* (H →L[ℂ] H)) (u : X) : homIn δ ρ ⊤ →ₗ[ℂ] H where
  toFun T := T.1 u
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

