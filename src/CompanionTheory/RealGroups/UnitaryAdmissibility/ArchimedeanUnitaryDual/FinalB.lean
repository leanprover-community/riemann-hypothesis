  refine (injective_iff_map_eq_zero _).2 fun T hT => Subtype.ext (ContinuousLinearMap.ext fun x => ?_)
  have h := norm_evalHom hδ hρ hu x T
  rw [hT, norm_zero, mul_zero] at h
  exact norm_eq_zero.1 h

