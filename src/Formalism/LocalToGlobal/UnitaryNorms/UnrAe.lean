def UnrAE (L : Type) [Field L] [NumberField L] : Prop :=
  ∀ χ : Ideles L →* ℂˣ, Continuous χ →
    ∀ᶠ v in Filter.cofinite, ∀ x : (v.adicCompletion L)ˣ, IsUnitAt v x → χ (localIdele L v x) = 1

