@[expose] public section

namespace PI.IndexUBound

def IndexUBound : Prop :=
  ∀ (ι : Type) (S : Finset ι) (g : ι → ℕ) (r : ℕ) (y : ℝ),
    (∀ v ∈ S, 2 ≤ g v) → ∑ v ∈ S, 1 / ((g v : ℝ) - 1) ≤ y →
      (1 - y) * ∏ v ∈ S, (g v : ℝ) ^ (r * (r - 1) / 2) ≤
        ∏ v ∈ S, ∏ i ∈ Finset.Ico 1 r, ((g v : ℝ) ^ i - 1)

end PI.IndexUBound
