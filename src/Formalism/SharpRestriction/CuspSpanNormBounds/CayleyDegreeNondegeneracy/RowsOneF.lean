  unfold smallTermAmplitude rows_al labelPairConstant
  refine mul_sqrt_div_mul_sqrt_div_le (a2 := C2 * (D.R.m : ℝ) ^ 2) (a4 := C2 * (D.R.m : ℝ) ^ 4)
