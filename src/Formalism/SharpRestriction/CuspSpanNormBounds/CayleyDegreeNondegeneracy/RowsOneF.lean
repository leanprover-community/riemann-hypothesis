    calc large₂.CGam * (D.R.m : ℝ) ^ 5 * D.R.f * large₂.sc.L + C2 * (D.R.m : ℝ) ^ 6 * D.R.f * large₂.sc.L
        = (large₂.CGam * (D.R.m : ℝ) ^ 5 + C2 * (D.R.m : ℝ) ^ 6) * ((D.R.f : ℝ) * large₂.sc.L) := by ring
      _ ≤ (C * (D.R.m : ℝ) ^ 6) * ((D.R.f : ℝ) * large₂.sc.L) := mul_le_mul_of_nonneg_right a1 hfL
