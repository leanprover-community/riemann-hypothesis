  obtain ⟨Mj, hj, h⟩ := jumps_bounded_crystalline (W := W) hDR hKb T hc
  exact ⟨Mj, hj, Finset.univ.sup Mj, h, fun i => Finset.le_sup (Finset.mem_univ i)⟩

