  have hwc : ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) wc (Ann P) := gcl_wRc_smooth P
  obtain ⟨hdw, hdbw⟩ := gcl_dZ_smooth hUo hwc
  refine ⟨fun ρ ζ => α ρ ζ - (a * NF.dZ wc ζ + b * NF.dZb wc ζ) * (wc ζ)⁻¹, fun ρ => ?_, ?_⟩
