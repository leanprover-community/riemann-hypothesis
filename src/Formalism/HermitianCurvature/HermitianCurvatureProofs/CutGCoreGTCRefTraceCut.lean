  have hexp : ∀ (Θ : Q.RadSp P.k P.r Bs.z Bs.z' Bs.π Bs.π') (x : (Fin P.r → ℂ) × ℂ), x ∈ NF.QR P.k P.r Bs.z Bs.z' →
