      NF.radR P.k P.r Bs.z Bs.z' Bs.μsec ((T (∑ σ, Θ σ) : Q.RadSp P.k P.r Bs.z Bs.z' Bs.π Bs.π') : Q.Fn P.k P.r (Wq →L[ℂ] Wp)) q.1 := by
    refine hloc Φ (∑ σ, Θ σ) q.1 q.1 hx0 hx0 rfl ?_
