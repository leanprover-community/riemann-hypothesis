      (Formalism.FourierDecayAlt.P.CutMP.En.hsVec_contDiff.comp_contDiffOn (hsliceΘ Φ q.1.1 q.2.1))
  have hfs' : ∀ σ, ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (f σ)
