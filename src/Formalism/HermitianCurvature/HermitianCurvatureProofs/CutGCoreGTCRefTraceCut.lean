    filter_upwards [(MA.Qset_open P.r P.TT).mem_nhds q.2] with x hx
    simp only [MA.ext, dif_pos hx]
    exact gcl_trR_val P Bs hpl hk2 e he Φ ρ ⟨x, hx⟩
  have hGs : ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) G (NF.QR P.k P.r Bs.z Bs.z') :=
