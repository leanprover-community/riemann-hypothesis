module

public import Lib.ClassField.GaloisCohomology.Cohomology
public import Lib.ClassField.GreenbergWiles.SplitPrimeReciprocity
import Lib.ClassField.GreenbergWiles.SelmerRelations

/-!
# Selmer groups of cohomology classes

The Selmer cocycles `New.selmerZ1` are cut out by conditions on cocycles. This file defines the
corresponding group of classes `New.selmerH1` in `H¹(Gal(Ω/K), M)`, cut out by the local conditions
on classes, and shows that the Selmer cocycles are exactly the cocycles whose class is a Selmer
class when the conditions contain the coboundaries.

* `New.classCondition`: the classes in `H¹` of the cocycles in a module of functions.
* `New.selmerH1`: the classes that are unramified outside `S ∪ P`, whose restriction to the
  decomposition group of `A v` lies in the class condition of `L v` for `v ∈ S`, and whose
  restriction to each complex conjugation is zero.
* `New.selmerH1.comap_π₁_eq`: the Selmer cocycles are the cocycles with Selmer class.

## Relation to the literature

Known; see `Lib.ClassField.GreenbergWiles.CocycleCounts` for sources.
-/

@[expose] public section

noncomputable section

namespace New

open NumberField DiscreteModule Finset

variable {K R : Type} [Field K] [EmbeddedNumberField K] [CommRing R]
  (M : DiscreteModule R Gal(Ω/K))

/-- The classes in `H¹(D, M)` of the cocycles in a module `L` of functions `D → M`. -/
def classCondition {D : Subgroup Gal(Ω/K)} (L : Submodule R (D → M)) :
    Submodule R ((M.restrictTo D).H 1) :=
  (L.comap (Z1 (M.restrictTo D).ρ).subtype).map (M.restrictTo D).π₁

/-- The Selmer classes: the classes in `H¹(Gal(Ω/K), M)` whose restriction to the inertia group of
every place `B` over a prime outside `S ∪ P` is zero, whose restriction to the decomposition group
of `A v` lies in the classes of the local conditions `L v` for `v ∈ S`, and whose restriction to
the group generated by each complex conjugation is zero. -/
def selmerH1 (S : Set (FinPlace K)) (A : FinPlace K → ClosurePlace)
    (L : ∀ v : FinPlace K, Submodule R (decompGroup Gal(Ω/K) (A v) → M)) (P : Set (FinPlace K)) :
    Submodule R (M.H 1) :=
  (⨅ v ∈ (S ∪ P)ᶜ, ⨅ (B : ClosurePlace) (_ : IsPlaceOver B v),
      LinearMap.ker (M.resH1 (subgroupIncl (inertiaGroup Gal(Ω/K) B)))) ⊓
    (⨅ v ∈ S, (classCondition M (L v)).comap
      (M.resH1 (subgroupIncl (decompGroup Gal(Ω/K) (A v))))) ⊓
    ⨅ (c : Gal(Ω/K)) (_ : IsComplexConj c),
      LinearMap.ker (M.resH1 (subgroupIncl (Subgroup.zpowers c)))

namespace selmerH1

variable {M}

/-- On a subgroup `U` that acts trivially, a cocycle has zero class in `H¹(U, M)` exactly when it
vanishes on `U`. -/
lemma resH1_π₁_eq_zero_iff {U : Subgroup Gal(Ω/K)} (hU : ∀ g ∈ U, M.ρ g = 1) (z : Z1 M.ρ) :
    M.resH1 (subgroupIncl U) (M.π₁ z) = 0 ↔ ∀ g ∈ U, (z : Gal(Ω/K) → M) g = 0 := by
  rw [resH1_π₁, ← LinearMap.mem_ker, ker_π₁, mem_B1_iff]
  constructor
  · rintro ⟨m, hm⟩ g hg
    have h := hm ⟨g, hg⟩
    rw [coe_resZ1_apply] at h
    change M.ρ g m - m = (z : Gal(Ω/K) → M) g at h
    rw [← h, hU g hg]
    simp
  · intro h
    refine ⟨0, fun g ↦ ?_⟩
    rw [coe_resZ1_apply, map_zero, sub_zero]
    exact (h g g.property).symm

/-- A cocycle that vanishes at `c` vanishes at every power of `c`. -/
lemma apply_zpow_eq_zero (z : Z1 M.ρ) {c : Gal(Ω/K)} (h : (z : Gal(Ω/K) → M) c = 0) (n : ℤ) :
    (z : Gal(Ω/K) → M) (c ^ n) = 0 := by
  have h_mul (g : Gal(Ω/K)) : (z : Gal(Ω/K) → M) (g * c) = (z : Gal(Ω/K) → M) g := by
    rw [z.property.2, h, map_zero, add_zero]
  induction n using Int.induction_on with
  | zero =>
    have h1 := z.property.2 1 1
    simpa using h1
  | succ n ih => rwa [zpow_add_one, h_mul]
  | pred n ih => rwa [← h_mul, ← zpow_add_one, sub_add_cancel]

/-- If the local condition `L` contains the coboundaries, the class of the restriction of a cocycle
`z` to `D` lies in the class condition of `L` exactly when the restriction lies in `L`. -/
lemma resH1_π₁_mem_classCondition_iff {D : Subgroup Gal(Ω/K)} {L : Submodule R (D → M)}
    (hL : LinearMap.range (coboundaryMap (M.restrictTo D).ρ) ≤ L) (z : Z1 M.ρ) :
    M.resH1 (subgroupIncl D) (M.π₁ z) ∈ classCondition M L ↔
      (fun g : D ↦ (z : Gal(Ω/K) → M) g) ∈ L := by
  rw [resH1_π₁]
  constructor
  · rintro ⟨y, hy, h_eq⟩
    have h_sub : M.resZ1 (subgroupIncl D) z - y ∈ B1 (M.restrictTo D).ρ := by
      rw [← ker_π₁, LinearMap.mem_ker, map_sub, ← h_eq, sub_self]
    obtain ⟨m, hm⟩ := mem_B1_iff.1 h_sub
    have h_cob : ((M.resZ1 (subgroupIncl D) z - y : Z1 (M.restrictTo D).ρ) : D → M) ∈ L :=
      hL ⟨m, funext hm⟩
    convert L.add_mem h_cob hy using 1
    ext g
    simp
    rfl
  · intro h
    exact ⟨M.resZ1 (subgroupIncl D) z, h, rfl⟩

variable {S : Set (FinPlace K)} {A : FinPlace K → ClosurePlace}
  {L : ∀ v : FinPlace K, Submodule R (decompGroup Gal(Ω/K) (A v) → M)} {P : Set (FinPlace K)}

/-- Let `M` be unramified outside `S`, let complex conjugations act trivially on `M`, and let the
local conditions `L v` contain the local coboundaries for `v ∈ S`. Then the Selmer cocycles
`selmerZ1` are exactly the continuous cocycles whose class lies in the Selmer classes
`selmerH1`. -/
theorem comap_π₁_eq (hu : ∀ g ∈ inertiaAbove Sᶜ, M.ρ g = 1)
    (hL : ∀ v ∈ S, LinearMap.range (coboundaryMap (M.restrictTo (decompGroup Gal(Ω/K) (A v))).ρ) ≤
      L v)
    (hcM : ∀ {c : Gal(Ω/K)}, IsComplexConj c → M.ρ c = 1) :
    (selmerH1 M S A L P).comap M.π₁ = (selmerZ1 M S A L P).comap (Z1 M.ρ).subtype := by
  ext z
  -- Each condition on the class of `z` is the corresponding condition on `z`.
  have h_unr : (∀ v ∈ (S ∪ P)ᶜ, ∀ B : ClosurePlace, IsPlaceOver B v →
      M.resH1 (subgroupIncl (inertiaGroup Gal(Ω/K) B)) (M.π₁ z) = 0) ↔
      ∀ g ∈ inertiaAbove (S ∪ P)ᶜ, (z : Gal(Ω/K) → M) g = 0 := by
    constructor
    · rintro h g ⟨v, hv, B, hB, hg⟩
      exact (resH1_π₁_eq_zero_iff (fun g' hg' ↦ hu g' ⟨v, fun h ↦ hv (.inl h), B, hB, hg'⟩) z).1
        (h v hv B hB) g hg
    · intro h v hv B hB
      exact (resH1_π₁_eq_zero_iff (fun g' hg' ↦ hu g' ⟨v, fun h ↦ hv (.inl h), B, hB, hg'⟩) z).2
        fun g hg ↦ h g ⟨v, hv, B, hB, hg⟩
  have h_loc : (∀ v ∈ S, M.resH1 (subgroupIncl (decompGroup Gal(Ω/K) (A v))) (M.π₁ z) ∈
      classCondition M (L v)) ↔
      ∀ v ∈ S, (fun g : decompGroup Gal(Ω/K) (A v) ↦ (z : Gal(Ω/K) → M) g) ∈ L v :=
    forall₂_congr fun v hv ↦ resH1_π₁_mem_classCondition_iff (hL v hv) z
  have h_conj : (∀ c : Gal(Ω/K), IsComplexConj c →
      M.resH1 (subgroupIncl (Subgroup.zpowers c)) (M.π₁ z) = 0) ↔
      ∀ c : Gal(Ω/K), IsComplexConj c → (z : Gal(Ω/K) → M) c = 0 := by
    refine forall₂_congr fun c hc ↦ ?_
    have h_triv : ∀ g ∈ Subgroup.zpowers c, M.ρ g = 1 := fun g hg ↦
      MonoidHom.mem_ker.1 (Subgroup.zpowers_le.2 (MonoidHom.mem_ker.2 (hcM hc)) hg)
    rw [resH1_π₁_eq_zero_iff h_triv]
    exact ⟨fun h ↦ h c (Subgroup.mem_zpowers c), fun h g ⟨n, hn⟩ ↦ by
      rw [← hn]
      exact apply_zpow_eq_zero z h n⟩
  simp only [Submodule.mem_comap, selmerH1, Submodule.mem_inf, Submodule.mem_iInf,
    LinearMap.mem_ker, Submodule.subtype_apply]
  rw [h_unr, h_loc, h_conj]
  simp only [selmerZ1, Submodule.mem_inf, Submodule.mem_pi, Submodule.mem_comap,
    Set.mem_ofPred_eq]
  exact ⟨fun ⟨⟨h1, h2⟩, h3⟩ ↦ ⟨⟨z.property, h1⟩, fun v hv ↦ h2 v hv, h3⟩,
    fun ⟨⟨_, h1⟩, h2, h3⟩ ↦ ⟨⟨h1, h2⟩, h3⟩⟩

end selmerH1

end New
