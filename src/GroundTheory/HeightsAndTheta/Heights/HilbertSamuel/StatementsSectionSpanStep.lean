    (y : (Σ k, ι k) → Ω) (a : K → ℤ) (q : ℕ) (w : Fin q → Ω),
    (∀ k, ∃ i, y ⟨k, i⟩ ≠ 0) → (∀ j, w j ∈ chartLat y a 1) → KH.GeneratesOn y a w →
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n →
      chartLat y a (n + 1) ≤ AddSubgroup.closure {t | ∃ s ∈ chartLat y a n, ∃ j, t = s * w j}

